{
  "version": "1.0",
  "description": "招投标规则库 - 用于检测招标文件中的违规条款和围串标风险",
  "rules": [
    {
      "rule_id": "RULE_T_001",
      "rule_type": "exclusive_brand",
      "description": "限定品牌或供应商（歧视性条款）",
      "severity": "high",
      "penalty": "修改招标文件，删除限制性品牌描述",
      "patterns": [
        "必须是.*品牌",
        "限于.*品牌",
        "仅限.*供应商",
        "指定品牌",
        "独家供应",
        "优先选用.*品牌"
      ],
      "suggestion": "改为'同等档次品牌'或'满足技术要求的品牌'"
    },
    {
      "rule_id": "RULE_T_002",
      "rule_type": "exclusive_qualification",
      "description": "排他性资质要求",
      "severity": "high",
      "penalty": "删除排他性资质条款",
      "patterns": [
        "必须具有甲级",
        "必须具有乙级",
        "特级资质",
        "一级资质",
        "仅限具有",
        "排斥.*资质"
      ],
      "suggestion": "调整为'具有相应资质'或'满足招标要求'"
    },
    {
      "rule_id": "RULE_T_003",
      "rule_type": "unclear_scoring",
      "description": "评分标准不透明",
      "severity": "medium",
      "penalty": "明确评分标准和权重",
      "patterns": [
        "综合评分法",
        "专家评审",
        "评标委员会决定"
      ],
      "suggestion": "明确各项评分指标、权重和分值分配"
    },
    {
      "rule_id": "RULE_T_004",
      "rule_type": "bid_similarity",
      "description": "投标文件高度相似（围标检测）",
      "severity": "critical",
      "penalty": "标记为高风险，提交人工复核",
      "threshold": {
        "similarity": 0.85,
        "pairs_count": 2
      },
      "suggestion": "提交招标监督部门人工复核"
    },
    {
      "rule_id": "RULE_T_005",
      "rule_type": "entity_connection",
      "description": "多家公司IP/联系人异常",
      "severity": "critical",
      "penalty": "标记关联关系，提交人工复核",
      "patterns": [
        "共享IP地址",
        "相同联系人",
        "相同注册地址"
      ],
      "suggestion": "标记主体关联，提交招标监督部门"
    },
    {
      "rule_id": "RULE_T_006",
      "rule_type": "price_anomaly",
      "description": "报价规律异常",
      "severity": "high",
      "penalty": "分析报价曲线，标记异常",
      "threshold": {
        "deviation": 0.15,
        "correlation": 0.9
      },
      "suggestion": "检查报价雷同性，分析价格操纵可能"
    },
    {
      "rule_id": "RULE_T_007",
      "rule_type": "audit_trail",
      "description": "评标过程缺乏可追溯审计",
      "severity": "medium",
      "penalty": "完善评标记录和审计追踪",
      "patterns": [
        "评标结果",
        "打分表",
        "评审记录"
      ],
      "suggestion": "建立完整的评标记录和审计追踪机制"
    },
    {
      "rule_id": "RULE_T_008",
      "rule_type": "region_limitation",
      "description": "地域限制条款",
      "severity": "medium",
      "penalty": "删除地域限制",
      "patterns": [
        "仅限本省",
        "仅限本市",
        "必须是本地企业",
        "本地注册"
      ],
      "suggestion": "删除地域限制，确保公平竞争"
    },
    {
      "rule_id": "RULE_T_009",
      "rule_type": "experience_exclusive",
      "description": "业绩排斥条款",
      "severity": "medium",
      "penalty": "调整为正面描述",
      "patterns": [
        "不接受.*业绩",
        "不包含.*业绩",
        "不包括.*经验"
      ],
      "suggestion": "调整为'具有类似项目经验'的正面描述"
    }
  ],
  "semantic_operators": {
    "P_REQUIRE": {
      "description": "必须满足的要求",
      "keywords": ["必须", "应当", "需要", "要求"]
    },
    "P_FORBID": {
      "description": "禁止性条款",
      "keywords": ["不得", "禁止", "不准", "排斥", "排除"]
    },
    "P_BASIS": {
      "description": "评标基准",
      "keywords": ["基准价", "参考价", "均价", "评分基准"]
    },
    "P_RECOMMEND": {
      "description": "推荐性条款",
      "keywords": ["推荐", "建议", "优先"]
    },
    "P_LIMIT": {
      "description": "限制性条款",
      "keywords": ["限于", "仅限", "只能是", "指定"]
    },
    "P_PREFER": {
      "description": "倾向性条款",
      "keywords": ["优先考虑", "同等条件下", "可以选择"]
    }
  },
  "risk_thresholds": {
    "green": 0.3,
    "yellow": 0.6,
    "red": 1.0
  },
  "coupling_rules": {
    "exclusive_brand + exclusive_qualification": 1.5,
    "exclusive_brand + unclear_scoring": 1.3,
    "bid_similarity + entity_connection": 1.8,
    "bid_similarity + price_anomaly": 1.6,
    "entity_connection + price_anomaly": 1.4
  }
}